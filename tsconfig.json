{
    "extends": "@docusaurus/tsconfig",
    "compilerOptions": {
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedSideEffectImports": true,
        "ignoreDeprecations": "6.0"
    },
    "exclude": [
        ".docusaurus",
        "build"
    ]
}